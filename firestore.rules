rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo pueden leer/escribir las sesiones de la app (inicio de sesión anónimo).
    match /products/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.resource.data.stock is number
                            && request.resource.data.stock >= 0;
      allow delete: if request.auth != null;
    }

    // Historial: se puede crear y marcar como "deshecha", nunca borrar.
    match /movements/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // Cuentas de clientes y sus carritos.
    match /customers/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
    match /carts/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // Compras finalizadas: se crean y se consultan, nunca se modifican ni se borran.
    match /orders/{id} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // Promociones.
    match /promos/{id} {
      allow read, create, update, delete: if request.auth != null;
    }
  }
}
